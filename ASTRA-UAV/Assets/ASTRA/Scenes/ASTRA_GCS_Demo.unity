  m_Script: {fileID: 11500000, guid: edd684f78ed5eb94b942a2637666866e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  displayName: Power Module / Current Sensor
  partDesignation: 
  category: 2
  status: 0
  massGrams: 30
  currentDrawA: 0
  description: Measures pack voltage and current for the flight controller and supplies
    regulated 5 V to it. This is the sensor the battery telemetry and the low-voltage
    failsafe depend on, so its accuracy determines whether the failsafe fires at
    the right time.
  engineeringNotes: '[UNVERIFIED - FLIGHT SAFETY RELEVANT] This is the most likely
    incompatibility in the whole build. The power module bundled with a Pixhawk 2.4.8
    is commonly rated to 4S / roughly 18 V, while a 6S pack reaches 25.2 V fully
    charged. Connecting a 4S module to a 6S pack can destroy it and take the flight
    controller with it. Confirm the module''s voltage rating BEFORE first power-up,
    or fit a 6S-rated module or a separate BEC. See Docs/10-UAV-Hardware-Layout.md.'
  explodeDirection: {x: 0, y: 0, z: 0}
  explodeDistanceM: 0.25
