  m_EditorClassIdentifier: 
  displayName: LiDAR
  partDesignation: 
  category: 5
  status: 2
  massGrams: 0
  currentDrawA: 0
  description: Mounting provision and software interface for a scanning LiDAR, for
    obstacle detection independent of lighting. The IObstacleDetector interface it
    would implement already exists, so adding the sensor would not require changes
    to the planner.
  engineeringNotes: '[FUTURE HARDWARE] NOT PRESENT ON THE AIRCRAFT. Not purchased,
    not mounted, not integrated. Its mass is entered as zero deliberately, so the
    mass budget reflects the aircraft that exists. Shown in a distinct colour so
    it cannot be mistaken for fitted equipment.'
  explodeDirection: {x: 0, y: 1, z: 0}
  explodeDistanceM: 0.22
