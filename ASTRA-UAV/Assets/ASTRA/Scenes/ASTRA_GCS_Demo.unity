  m_Script: {fileID: 11500000, guid: edd684f78ed5eb94b942a2637666866e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  displayName: GNSS Receiver + Compass
  partDesignation: 
  category: 5
  status: 0
  massGrams: 32
  currentDrawA: 0.1
  description: Provides absolute position and heading. Raised on a mast and set back
    from the power wiring because the magnetometer inside it is easily corrupted
    by the magnetic field of the propulsion currents - which is a real and frequently
    underestimated source of heading error on multirotors.
  engineeringNotes: '[SIMULATED] Simulated with representative noise, dilution of
    precision and satellite count. The GPS-denied demonstration works by disabling
    this provider, which is an honest way to show the consequence but is not the
    same as a real jamming or multipath environment, where degradation is gradual
    and the receiver reports a fix it should not be trusted with.'
  explodeDirection: {x: 0, y: 1, z: 0}
  explodeDistanceM: 0.16
