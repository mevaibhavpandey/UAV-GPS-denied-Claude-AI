  m_Script: {fileID: 11500000, guid: edd684f78ed5eb94b942a2637666866e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  displayName: Battery - 6S 6200 mAh LiPo
  partDesignation: 6S1P 22.2 V (assumed)
  category: 2
  status: 0
  massGrams: 900
  currentDrawA: 0
  description: Six-cell lithium polymer pack, 6200 mAh nominal, 22.2 V nominal, about
    138 Wh. Mounted below the centre plate and on the centre line so the centre of
    mass stays under the rotor plane. Modelled with a realistic discharge curve and
    internal resistance, so voltage sags under load and the sag reduces available
    thrust.
  engineeringNotes: '[ESTIMATE] Mass and physical dimensions are estimates. The pack''s
    C rating is not stated in the brief; the modelled full-throttle draw implies
    a minimum of about 9C, so a pack below that rating would sag badly and could
    be damaged. Verify the C rating on the pack label.'
  explodeDirection: {x: 0, y: -1, z: 0}
  explodeDistanceM: 0.18
