  m_Script: {fileID: 11500000, guid: edd684f78ed5eb94b942a2637666866e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  displayName: Power Distribution Board
  partDesignation: 
  category: 2
  status: 0
  massGrams: 25
  currentDrawA: 0
  description: Splits the pack's output to the four ESCs. Carries the full propulsion
    current, so its trace width and connector rating set a hard ceiling on the aircraft's
    power.
  engineeringNotes: '[UNVERIFIED] No PDB part is named in the brief. Modelled current
    at full throttle is about 55 A total, so the board and every connector in the
    propulsion path must be rated above that with margin.'
  explodeDirection: {x: 0, y: 0, z: 0}
  explodeDistanceM: 0.25
