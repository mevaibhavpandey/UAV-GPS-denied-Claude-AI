  m_Script: {fileID: 11500000, guid: edd684f78ed5eb94b942a2637666866e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  displayName: Flight Controller
  partDesignation: Pixhawk 2.4.8 (assumed)
  category: 3
  status: 0
  massGrams: 38
  currentDrawA: 0.25
  description: Runs the attitude and position control loops and the flight state
    machine, and houses the IMU, barometer and internal compass. In ASTRA its role
    is played by FlightControlSystem, which reproduces the same cascaded control
    architecture and the same arming and failsafe logic.
  engineeringNotes: '[SIMULATED] The control loops in this project are a faithful
    reproduction of the ARCHITECTURE a Pixhawk running ArduPilot uses, and the gains
    are expressed in the same units so they transfer. They are NOT flight-certified
    firmware: there is no sensor redundancy, no EKF with innovation gating, no watchdog
    and none of the field history that real autopilot software carries.'
  explodeDirection: {x: 0, y: 1, z: 0}
  explodeDistanceM: 0.14
