  m_Script: {fileID: 11500000, guid: edd684f78ed5eb94b942a2637666866e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  displayName: Motor 4 + Propeller
  partDesignation: 5010 360KV / 15x5.5 (assumed)
  category: 1
  status: 0
  massGrams: 195
  currentDrawA: 0
  description: Brushless outrunner and 15 inch propeller at the rear-right position,
    rotating clockwise viewed from above. Thrust is applied to the rigidbody at THIS
    transform, which is why roll and pitch emerge from thrust differentials rather
    than being commanded as torques. Its reaction torque about the yaw axis is what
    makes yaw control possible.
  engineeringNotes: '[UNVERIFIED - FLIGHT SAFETY RELEVANT] Motor and propeller identified
    from the project brief, not from a datasheet. The maximum thrust figure in UavConfiguration
    is the single most important unverified number in the whole model: every performance
    claim depends on it. It must be replaced with a manufacturer thrust table or
    a measured static thrust test before any figure from this simulation is quoted
    as a specification.'
  explodeDirection: {x: 0.70710677, y: 0.4, z: -0.70710677}
  explodeDistanceM: 0.16
