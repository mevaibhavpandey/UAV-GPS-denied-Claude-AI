  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: edd684f78ed5eb94b942a2637666866e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  displayName: Forward Camera
  partDesignation: 
  category: 7
  status: 1
  massGrams: 45
  currentDrawA: 0.35
  description: Forward-looking camera. Feeds the visual navigation used when GPS
    is unavailable, and provides the operator's first-person view.
  engineeringNotes: '[DEMONSTRATION] The visual odometry driven by this camera is
    a SIMPLIFIED STAND-IN, not an implementation of visual SLAM. It does not extract
    features, does not match them between frames, does not perform bundle adjustment
    and does not close loops. It reproduces the OBSERVABLE BEHAVIOUR of a VIO system
    - a drifting position estimate whose uncertainty grows without absolute reference
    - so that the consequence of losing GPS can be shown honestly. It must not be
    described as SLAM.'
  explodeDirection: {x: 0, y: 0, z: 1}
  explodeDistanceM: 0.14
