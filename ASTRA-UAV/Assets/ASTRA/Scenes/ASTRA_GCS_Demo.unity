  m_Script: {fileID: 11500000, guid: edd684f78ed5eb94b942a2637666866e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  displayName: Companion Computer
  partDesignation: Raspberry Pi 5 (assumed)
  category: 4
  status: 0
  massGrams: 65
  currentDrawA: 3
  description: 'Carries the perception and route planning that is too heavy for the
    flight controller: obstacle detection, the planner, and the visual navigation
    used when GPS is unavailable. Talks to the flight controller over serial, as
    MAVLink.'
  engineeringNotes: '[ESTIMATE] Current draw is an estimate and depends heavily on
    load; a Pi 5 running vision continuously draws considerably more than one sitting
    idle. Thermal behaviour inside an airframe is not modelled at all, and a Pi 5
    under sustained vision load will throttle without active cooling - which would
    show up in flight as the perception rate quietly dropping.'
  explodeDirection: {x: 0, y: 1, z: 0}
  explodeDistanceM: 0.2
