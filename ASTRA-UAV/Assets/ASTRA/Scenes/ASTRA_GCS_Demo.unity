  partDesignation: 
  category: 6
  status: 0
  massGrams: 20
  currentDrawA: 0.2
  description: Carries the MAVLink telemetry stream to the ground station. This is
    the link the ground control interface reads, and its latency and packet loss
    are what make a remote operator's view of the aircraft lag behind reality.
  engineeringNotes: '[UNVERIFIED] No specific radio is named in the brief. Range
    and link budget are not modelled; link quality in the simulation is a representative
    figure, not a propagation calculation.'
  explodeDirection: {x: 0, y: 0, z: 0}
  explodeDistanceM: 0.25
