  m_Script: {fileID: 11500000, guid: edd684f78ed5eb94b942a2637666866e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  displayName: 5 V / 5 A UBEC
  partDesignation: 
  category: 2
  status: 0
  massGrams: 20
  currentDrawA: 0
  description: Steps the pack voltage down to 5 V for the companion computer, which
    needs more current than the flight controller's own regulator can supply.
  engineeringNotes: '[UNVERIFIED] A Raspberry Pi 5 can demand around 5 A at 5 V under
    load, so a marginal BEC will brown it out mid-flight - which would look exactly
    like a software crash and would be diagnosed as one. Verify the BEC''s continuous
    rating, not its peak.'
  explodeDirection: {x: 0, y: 0, z: 0}
  explodeDistanceM: 0.25
